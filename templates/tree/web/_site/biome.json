{
  "$schema": "https://biomejs.dev/schemas/2.3.14/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "src/**/*",
      "*.ts",
      "*.tsx",
      "*.css",
      "*.json",
      "vitest.setup.ts"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "vcs": { "enabled": false, "useIgnoreFile": true },
  "formatter": { "indentStyle": "space", "indentWidth": 2 },
  "linter": { "enabled": true, "rules": { "recommended": true } }
}
