# Copy to docker/build.env and fill in (docker/build.env is gitignored).
# Build machine only — used by make api-docker-login / api-docker-build / api-docker-release.

GITHUB_USER=your-github-username
GITHUB_TOKEN=ghp_...          # PAT with write:packages

# Uncomment when building with WYSCAN_SOURCE=registry (Mode B):
# NPM_TOKEN=ghp_...
