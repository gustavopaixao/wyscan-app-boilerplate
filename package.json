{
  "name": "wyscan-app-boilerplate",
  "version": "0.1.0",
  "description": "Scaffold a full-stack monorepo (Hono API, Next.js web apps, Expo mobile) with Claude/Cursor tooling preconfigured.",
  "type": "module",
  "bin": {
    "wyscan-app-boilerplate": "bin/create.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "sync": "node scripts/sync-from-reference.mjs --from ../botonistas",
    "sync:check": "node scripts/sync-from-reference.mjs --from ../botonistas --check",
    "format:authored": "node scripts/format-authored.mjs",
    "manifest": "node scripts/sync-authored-manifest.mjs",
    "manifest:check": "node scripts/sync-authored-manifest.mjs --check"
  },
  "license": "UNLICENSED",
  "private": false
}
